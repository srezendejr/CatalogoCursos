<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CTED Catálogo de Cursos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cted.CatalogoCursos.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="SESI Indústria">
                    <img src="~/Recursos/Imagens/logo-sesi-industria-primary.svg" alt="SESI Indústria" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#siteNavbar" aria-controls="siteNavbar"
                        aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="siteNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Ava" asp-action="Index">AVA</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Courses" asp-action="Index">Catálogo</a>
                        </li>
                        <li class="nav-item mt-2 mt-lg-0">
                            <a class="btn btn-brand" asp-area="" asp-controller="Courses" asp-action="Index">Ver cursos</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer__top">
                <img src="~/Recursos/Imagens/logo-sesi-industria-white.svg" alt="SESI Indústria" />
                <p class="mb-0">Formação profissional com foco em indústria, tecnologia e empregabilidade.</p>
            </div>
            <div class="site-footer__bottom">
                <small>&copy; @DateTime.UtcNow.Year SESI Indústria - Catálogo de Cursos</small>
                <div class="site-social">
                    <a href="#" aria-label="Facebook"><img src="~/Recursos/Imagens/icon-facebook-24px.svg" alt="" /></a>
                    <a href="#" aria-label="Instagram"><img src="~/Recursos/Imagens/icon-instagram-24px.svg" alt="" /></a>
                    <a href="#" aria-label="LinkedIn"><img src="~/Recursos/Imagens/icon-linkedIn-24px.svg" alt="" /></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
